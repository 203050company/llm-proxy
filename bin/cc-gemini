#!/bin/bash

# --- Configuration ---
PORT=8080
BASE_URL="http://localhost:$PORT"
MODEL="gemini-3.1-pro" # Real model name

# --- Check and Start Proxy ---
if ! curl -s "http://localhost:$PORT/health" > /dev/null; then
    echo "Proxy server is not responding at port $PORT. Starting via docker-compose..."
    
    # Get the real directory of this script, following symlinks
    SOURCE="${BASH_SOURCE[0]}"
    while [ -h "$SOURCE" ]; do
        DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
        SOURCE="$(readlink "$SOURCE")"
        [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
    done
    SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
    PROJECT_ROOT="$( dirname "$SCRIPT_DIR" )"
    
    cd "$PROJECT_ROOT" || exit 1
    docker compose up -d
    
    echo "Waiting for proxy to be ready..."
    MAX_RETRIES=30
    RETRY_COUNT=0
    while ! curl -s "http://localhost:$PORT/health" > /dev/null; do
        sleep 1
        RETRY_COUNT=$((RETRY_COUNT+1))
        if [ $RETRY_COUNT -ge $MAX_RETRIES ]; then
            echo "Error: Proxy failed to start after ${MAX_RETRIES}s"
            exit 1
        fi
    done
    echo "Proxy is up and healthy!"
fi

sync_gemini_cli_auth() {
    if [ "${CC_GEMINI_SYNC_CLI_AUTH:-1}" = "0" ]; then
        return
    fi

    STATUS_JSON="$(curl -fsS "$BASE_URL/auth/gemini/cli-auth" 2>/dev/null || true)"
    if [ -z "$STATUS_JSON" ]; then
        echo "Warning: Could not check Gemini CLI auth status; continuing."
        return
    fi

    if node -e 'const s=JSON.parse(process.argv[1]); process.exit(s.matchedEntryId ? 0 : 1)' "$STATUS_JSON" 2>/dev/null; then
        return
    fi

    echo "Gemini CLI auth does not match a proxy account. Applying default paid Gemini account..."
    APPLY_JSON="$(curl -fsS -X POST "$BASE_URL/auth/gemini/cli-auth/apply-default" 2>/dev/null || true)"
    if [ -z "$APPLY_JSON" ]; then
        echo "Warning: Could not apply default Gemini CLI auth; continuing."
        return
    fi

    if ! node -e '
const r=JSON.parse(process.argv[1]);
if (!r.success) process.exit(1);
const email = r.email || (r.status && r.status.currentEmail) || "unknown";
console.log(`Applied Gemini CLI auth for ${email}`);
' "$APPLY_JSON" 2>/dev/null; then
        echo "Warning: Default Gemini CLI auth apply failed; continuing."
    fi
}

sync_gemini_cli_auth

# --- Start Claude Code session ---
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_API_KEY="sk-ant-abc-123" # Dummy key
export ANTHROPIC_MODEL="${MODEL}[1m]"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${MODEL}[1m]"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${MODEL}[1m]"
export ANTHROPIC_SMALL_FAST_MODEL="gemini-3.1-flash-lite[1m]"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="gemini-3.1-flash-lite[1m]"

echo "Starting Claude Code session with model: $MODEL"
CLAUDE_ARGS=()
if [ "${CC_GEMINI_BARE:-1}" != "0" ]; then
    case " $* " in
        *" --bare "*) ;;
        *) CLAUDE_ARGS+=(--bare) ;;
    esac
fi
claude "${CLAUDE_ARGS[@]}" "$@"
