#!/bin/bash

# --- Configuration ---
PORT="${CC_OPENCODE_PROXY_PORT:-8080}"
BASE_URL="${CC_OPENCODE_BASE_URL:-http://127.0.0.1:$PORT}"
DEFAULT_MODEL="opencode-kimi-k2.7"
MODEL="${CC_OPENCODE_MODEL:-$DEFAULT_MODEL}"
AGENT_MODEL="${CC_OPENCODE_AGENT_MODEL:-$DEFAULT_MODEL}"
SETTINGS_PATH="${CC_OPENCODE_SETTINGS:-$HOME/.claude/opencode-proxy-settings.json}"

llm_proxy_root() {
    if [ -f "$HOME/llm-proxy/docker-compose.yml" ]; then
        printf '%s\n' "$HOME/llm-proxy"
        return
    fi

    SOURCE="${BASH_SOURCE[0]}"
    while [ -h "$SOURCE" ]; do
        DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
        SOURCE="$(readlink "$SOURCE")"
        [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
    done
    SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
    dirname "$SCRIPT_DIR"
}

parse_args() {
    CLAUDE_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --model)
                shift
                MODEL="${1:-}"
                if [[ -z "$MODEL" ]]; then
                    echo "Error: --model requires a value" >&2
                    exit 2
                fi
                ;;
            --model=*)
                MODEL="${1#--model=}"
                if [[ -z "$MODEL" ]]; then
                    echo "Error: --model requires a value" >&2
                    exit 2
                fi
                ;;
            *)
                CLAUDE_ARGS+=("$1")
                ;;
        esac
        shift
    done
}

start_proxy_if_needed() {
    if curl -s "$BASE_URL/health" > /dev/null; then
        return
    fi

    echo "llm-proxy is not responding at port $PORT. Starting shared proxy..."

    PROJECT_ROOT="$(llm_proxy_root)"
    cd "$PROJECT_ROOT" || exit 1
    docker compose up -d

    echo "Waiting for proxy to be ready..."
    MAX_RETRIES=30
    RETRY_COUNT=0
    while ! curl -s "$BASE_URL/health" > /dev/null; do
        sleep 1
        RETRY_COUNT=$((RETRY_COUNT+1))
        if [ $RETRY_COUNT -ge $MAX_RETRIES ]; then
            echo "Error: Proxy failed to start after ${MAX_RETRIES}s"
            exit 1
        fi
    done
    echo "Proxy is up and healthy!"
}

prepare_agent_view_config() {
    local agent_config_dir="${CC_OPENCODE_CONFIG_DIR:-$HOME/.claude-agent-view/opencode-go/all}"
    local shared_entry

    mkdir -p "$agent_config_dir" "$agent_config_dir/daemon" "$agent_config_dir/jobs" "$agent_config_dir/projects"
    for shared_entry in \
        settings.json \
        settings.local.json \
        CLAUDE.md \
        commands \
        plugins \
        skills \
        hooks \
        scripts \
        bin \
        awesome-statusline.sh \
        .credentials.json \
        .buddy-reroll.json
    do
        if [[ -e "$HOME/.claude/$shared_entry" && ! -e "$agent_config_dir/$shared_entry" && ! -L "$agent_config_dir/$shared_entry" ]]; then
            ln -s "$HOME/.claude/$shared_entry" "$agent_config_dir/$shared_entry"
        fi
    done

    printf '%s\n' "$agent_config_dir"
}

parse_args "$@"
set -- "${CLAUDE_ARGS[@]}"
start_proxy_if_needed

export CLAUDE_CONFIG_DIR
CLAUDE_CONFIG_DIR="$(prepare_agent_view_config)"

if [[ "${1:-}" == "agents" ]]; then
    proxy_api_key="$("$HOME/.claude/bin/codex-proxy-api-key.sh")" || exit 1
    echo "Starting OpenCode Agent View with default new-session model: $AGENT_MODEL"
    env \
        CLAUDE_CONFIG_DIR="$CLAUDE_CONFIG_DIR" \
        ANTHROPIC_BASE_URL="$BASE_URL" \
        ANTHROPIC_API_KEY="$proxy_api_key" \
        ANTHROPIC_MODEL="$AGENT_MODEL" \
        ANTHROPIC_DEFAULT_OPUS_MODEL="$AGENT_MODEL" \
        ANTHROPIC_DEFAULT_SONNET_MODEL="$AGENT_MODEL" \
        ANTHROPIC_DEFAULT_HAIKU_MODEL="$AGENT_MODEL" \
        ANTHROPIC_SMALL_FAST_MODEL="$AGENT_MODEL" \
        API_TIMEOUT_MS="3000000" \
        CLAUDE_CODE_MAX_CONTEXT_TOKENS="400000" \
        CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY="1" \
        DISABLE_COMPACT="1" \
        claude "$@"
    exit
fi

echo "Starting Claude Code OpenCode session with model: $MODEL"
env \
    -u ANTHROPIC_API_KEY \
    -u ANTHROPIC_AUTH_TOKEN \
    -u ANTHROPIC_MODEL \
    -u ANTHROPIC_SMALL_FAST_MODEL \
    CLAUDE_CONFIG_DIR="$CLAUDE_CONFIG_DIR" \
    claude \
    --settings "$SETTINGS_PATH" \
    --model "$MODEL" \
    "$@" \
    --dangerously-skip-permissions
