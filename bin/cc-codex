#!/bin/bash

# --- Configuration ---
PORT=8080
BASE_URL="http://127.0.0.1:$PORT"
MODEL="gpt-5.3-codex" # Default codex model alias

llm_proxy_root() {
    if [ -f "$HOME/llm-proxy/docker-compose.yml" ]; then
        printf '%s\n' "$HOME/llm-proxy"
        return
    fi

    SOURCE="${BASH_SOURCE[0]}"
    while [ -h "$SOURCE" ]; do
        DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
        SOURCE="$(readlink "$SOURCE")"
        [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
    done
    SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
    dirname "$SCRIPT_DIR"
}

# --- Check and Start Proxy ---
if ! curl -s "$BASE_URL/health" > /dev/null; then
    echo "llm-proxy is not responding at port $PORT. Starting shared proxy..."

    PROJECT_ROOT="$(llm_proxy_root)"
    cd "$PROJECT_ROOT" || exit 1
    docker compose up -d
    
    echo "Waiting for proxy to be ready..."
    MAX_RETRIES=30
    RETRY_COUNT=0
    while ! curl -s "$BASE_URL/health" > /dev/null; do
        sleep 1
        RETRY_COUNT=$((RETRY_COUNT+1))
        if [ $RETRY_COUNT -ge $MAX_RETRIES ]; then
            echo "Error: Proxy failed to start after ${MAX_RETRIES}s"
            exit 1
        fi
    done
    echo "Proxy is up and healthy!"
fi

# --- Start Claude Code session ---
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_API_KEY="unused"
export ANTHROPIC_MODEL="$MODEL"

echo "Starting Claude Code session with model: $MODEL"
claude "$@"
