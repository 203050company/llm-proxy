#!/bin/bash

# --- Configuration ---
PORT=8080
BASE_URL="http://127.0.0.1:$PORT"
MODEL="gpt-5.3-codex" # Default codex model alias

llm_proxy_root() {
    if [ -f "$HOME/llm-proxy/docker-compose.yml" ]; then
        printf '%s\n' "$HOME/llm-proxy"
        return
    fi

    SOURCE="${BASH_SOURCE[0]}"
    while [ -h "$SOURCE" ]; do
        DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
        SOURCE="$(readlink "$SOURCE")"
        [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
    done
    SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
    dirname "$SCRIPT_DIR"
}

# --- Check and Start Proxy ---
if ! curl -s "$BASE_URL/health" > /dev/null; then
    echo "llm-proxy is not responding at port $PORT. Starting shared proxy..."

    PROJECT_ROOT="$(llm_proxy_root)"
    cd "$PROJECT_ROOT" || exit 1
    docker compose up -d
    
    echo "Waiting for proxy to be ready..."
    MAX_RETRIES=30
    RETRY_COUNT=0
    while ! curl -s "$BASE_URL/health" > /dev/null; do
        sleep 1
        RETRY_COUNT=$((RETRY_COUNT+1))
        if [ $RETRY_COUNT -ge $MAX_RETRIES ]; then
            echo "Error: Proxy failed to start after ${MAX_RETRIES}s"
            exit 1
        fi
    done
    echo "Proxy is up and healthy!"
fi

prepare_agent_view_config() {
    local agent_config_dir="$HOME/.claude-agent-view/codex"
    local shared_entry

    mkdir -p "$agent_config_dir" "$agent_config_dir/daemon" "$agent_config_dir/jobs" "$agent_config_dir/projects"
    for shared_entry in \
        settings.json \
        settings.local.json \
        CLAUDE.md \
        commands \
        plugins \
        skills \
        hooks \
        scripts \
        bin \
        awesome-statusline.sh \
        .credentials.json \
        .buddy-reroll.json
    do
        if [[ -e "$HOME/.claude/$shared_entry" && ! -e "$agent_config_dir/$shared_entry" && ! -L "$agent_config_dir/$shared_entry" ]]; then
            ln -s "$HOME/.claude/$shared_entry" "$agent_config_dir/$shared_entry"
        fi
    done

    printf '%s\n' "$agent_config_dir"
}

# --- Start Claude Code session ---
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_API_KEY="unused"
export ANTHROPIC_MODEL="$MODEL"
export CLAUDE_CONFIG_DIR
CLAUDE_CONFIG_DIR="$(prepare_agent_view_config)"

echo "Starting Claude Code session with model: $MODEL"
env \
    -u CLAUDE_CODE_MAX_CONTEXT_TOKENS \
    -u DISABLE_COMPACT \
    claude "$@"
